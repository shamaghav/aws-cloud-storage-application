# ─────────────────────────────────────────────────────────────────────────────
# Cloud File Storage Application Using AWS — environment variable template
#
# IMPORTANT: This file is safe to commit to Git.
#            It contains only placeholder values — never real credentials.
#
# HOW TO USE:
#   cp .env.example .env
#   Edit .env and replace every PLACEHOLDER with real values.
#
# WARNING: .env is listed in .gitignore and must NEVER be committed.
#          See AWS_SECURITY.md for the full credential security guide.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (required by the platform health check) ───────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── AWS IAM credentials ──────────────────────────────────────────────────────
# Create a dedicated IAM user with the least-privilege policy in AWS_SECURITY.md.
# Required permissions: s3:ListBucket, s3:ListBucketVersions, s3:GetObject,
#                       s3:PutObject, s3:DeleteObject — scoped to your bucket.
#
# !! NEVER put real key values here — this file is committed to Git.
# !! Real keys go only in .env, which is gitignored.
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID_PLACEHOLDER
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY_PLACEHOLDER

# ── AWS region ───────────────────────────────────────────────────────────────
# Must match the region where your S3 bucket was created.
# Example values: us-east-1  eu-west-1  ap-southeast-1
AWS_REGION=us-east-1

# ── Amazon S3 bucket name ────────────────────────────────────────────────────
# The bucket must already exist. Both variable names are accepted.
AWS_BUCKET_NAME=your-s3-bucket-name-here
AWS_S3_BUCKET_NAME=your-s3-bucket-name-here

# ── Upload prefix (folder inside the bucket) ─────────────────────────────────
# All uploads are placed under this prefix.
# Sub-folders (images/, documents/, videos/, audio/, archives/, other/) are
# appended automatically based on the detected file type.
# Resulting path:  uploads/documents/1700000000000-uuid-report.pdf
AWS_S3_PREFIX=uploads/

# ── Upload size limit ────────────────────────────────────────────────────────
# Maximum file size accepted by the upload endpoint, in bytes.
# Default when omitted: 52428800 (50 MB).
MAX_UPLOAD_SIZE_BYTES=52428800

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Must be at least 32 characters. Never commit a real value here.
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long

# ── Optional: local S3-compatible endpoint (LocalStack, MinIO, etc.) ─────────
# Uncomment to test without a real AWS account.
# AWS_S3_ENDPOINT=http://localhost:4566
# AWS_S3_FORCE_PATH_STYLE=true
