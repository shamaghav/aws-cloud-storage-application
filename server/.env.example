# ─────────────────────────────────────────────────────────────────────────────
# Cloud File Storage Application — standalone Express backend template
#
# IMPORTANT: This file is safe to commit to Git.
#            It contains only placeholder values — never real credentials.
#
# HOW TO USE:
#   cp server/.env.example server/.env
#   Edit server/.env and replace every PLACEHOLDER with real values.
#
# WARNING: server/.env is listed in server/.gitignore and must NEVER be
#          committed to Git. See AWS_SECURITY.md for the full security guide.
# ─────────────────────────────────────────────────────────────────────────────

# ── Express server ───────────────────────────────────────────────────────────
PORT=5000

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── AWS IAM credentials ──────────────────────────────────────────────────────
# Required permissions: s3:ListBucket, s3:ListBucketVersions, s3:GetObject,
#                       s3:PutObject, s3:DeleteObject — on your specific bucket.
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID_PLACEHOLDER
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY_PLACEHOLDER

# ── AWS region ───────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# ── Amazon S3 bucket name ────────────────────────────────────────────────────
# Both names are accepted; set whichever matches your .env.
AWS_BUCKET_NAME=your-s3-bucket-name-here
AWS_S3_BUCKET_NAME=your-s3-bucket-name-here

# ── Upload prefix ────────────────────────────────────────────────────────────
# Sub-folders are appended automatically. Resulting path:
#   uploads/images/1700000000-uuid-photo.jpg
AWS_S3_PREFIX=uploads/

# ── Upload size limit ────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=52428800

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
